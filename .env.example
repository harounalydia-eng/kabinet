# Optional — server-side routine extraction.
# When both are set, "Turn into routine" first calls the Supabase Edge Function
# `extract-routine` (see docs/ROUTINE_EXTRACTION.md). Without them, the free
# rule-based extractor runs in the browser. Never put model or platform API keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Import from iPhone (POST /functions/v1/import). Only VITE_SUPABASE_URL is needed:
# the app generates a device token and shows it in Settings → Import from iPhone.
# See docs/IMPORT_API.md.
