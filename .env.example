# Accounts + Save to KABINET (Supabase). PUBLIC values only: the project URL and the
# publishable key. Never the service-role key, the database password or a model key.
# Without them the app runs on this device alone: no sign-in, no Shortcut.
# Also enables "Turn into routine" through the `extract-routine` edge function (docs/ROUTINE_EXTRACTION.md).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Save to KABINET Shortcut — optional iCloud share link (Shortcuts → share → Copy iCloud Link).
# When set, "Add KABINET Shortcut" opens it; otherwise the signed file in public/shortcuts is used.
VITE_SHORTCUT_ICLOUD_URL=

# The check-in app (skin analysis). When set, product pages offer "Check with KABINET".
VITE_KABINET_CHECK_URL=
